#!/bin/sh
# package.py expands this token: /var/jb for rootless, empty for RootHide.
PREFIX='@TB_PACKAGE_PREFIX@'
ROOT="${DPKG_ROOT:-}${PREFIX}"
APP="$ROOT/Applications/ThemeBoard.app"
chown -R mobile:mobile "$APP" 2>/dev/null || true

# Always create the directory in this package's own installation root.
# Do not pick an unrelated randomized .jbroot directory.
mkdir -p "$ROOT/Library/ThemeBoard/Themes" "$ROOT/Library/ThemeBoard/Assets" 2>/dev/null
chown -R mobile:mobile "$ROOT/Library/ThemeBoard" 2>/dev/null
chmod -R 0755 "$ROOT/Library/ThemeBoard" 2>/dev/null
if [ -x "$ROOT/usr/bin/uicache" ]; then
  "$ROOT/usr/bin/uicache" -p "$APP" 2>/dev/null || true
fi
exit 0
